# Server Configuration
PORT=4174
# Optional custom SQLite file path (defaults to server/data/montessori.sqlite)
# MONTESSORI_DB_PATH=server/data/montessori.sqlite

# Google OAuth 2.0 Credentials (Google Cloud Console -> OAuth 2.0 Client IDs)
# Authorized Redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override if running behind a proxy or production domain
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Facebook Login App Credentials (Meta for Developers -> Facebook Login)
# Valid OAuth Redirect URI: http://localhost:5173/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_REDIRECT_URI=http://localhost:5173/api/auth/facebook/callback

# SMTP Email Configuration (Required for live Forgot Password email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@montessorilearningpod.edu

